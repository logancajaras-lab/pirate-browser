{
  "name": "pirate-browser",
  "version": "1.3.3",
  "description": "Custom Electron Browser with Native Video Downloading",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win portable"
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "^2.17.3",
    "ffmpeg-static": "^5.3.0",
    "fluent-ffmpeg": "^2.1.3",
    "m3u8-parser": "^7.1.0",
    "youtube-dl-exec": "^3.1.12"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "com.pirate.browser",
    "productName": "Pirate Browser",
    "win": {
      "target": "portable"
    }
  }
}
